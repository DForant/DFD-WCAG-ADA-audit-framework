{"dlitem":{"wcagId":"1.3.1","wcagLevel":"A","category":"Structure","title":"Info and Relationships","plainDescription":"Definition list items must be correctly parented within a dl element.","severity":"moderate","processType":"automated","remediationSummary":"Ensure dt and dd are children of dl.","compliantCodeExample":"<dl><dt>Term</dt><dd>Definition</dd></dl>"},"list":{"wcagId":"1.3.1","wcagLevel":"A","category":"Structure","title":"List Structure","plainDescription":"Lists must only contain allowed list items.","severity":"moderate","processType":"automated","remediationSummary":"Use proper li elements within ul or ol.","compliantCodeExample":"<ul><li>Item</li></ul>"},"listitem":{"wcagId":"1.3.1","wcagLevel":"A","category":"Structure","title":"List Items","plainDescription":"List items must be contained in a list parent.","severity":"moderate","processType":"automated","remediationSummary":"Wrap li inside ul, ol, or role list.","compliantCodeExample":"<ul><li>Item</li></ul>"},"td-headers":{"wcagId":"1.3.1","wcagLevel":"A","category":"Structure","title":"Table Headers","plainDescription":"Data tables must use proper header associations.","severity":"moderate","processType":"automated","remediationSummary":"Use header attributes or th elements.","compliantCodeExample":"<table><tr><th id=\"h1\">Name</th></tr><tr><td headers=\"h1\">Value</td></tr></table>"},"css-orientation-lock":{"wcagId":"1.3.4","wcagLevel":"AA","category":"Visual","title":"Orientation","plainDescription":"Content must not be locked to a specific orientation.","severity":"moderate","processType":"automated","remediationSummary":"Allow content to rotate.","compliantCodeExample":"@media (orientation: auto) {}"},"autocomplete-valid":{"wcagId":"1.3.5","wcagLevel":"AA","category":"Forms","title":"Identify Input Purpose","plainDescription":"Inputs must have valid autocomplete attributes.","severity":"moderate","processType":"automated","remediationSummary":"Add correct autocomplete attribute.","compliantCodeExample":"<input type=\"text\" autocomplete=\"given-name\" />"},"bypass":{"wcagId":"2.4.1","wcagLevel":"A","category":"Navigation","title":"Bypass Blocks","plainDescription":"Users must be able to bypass repetitive navigation.","severity":"moderate","processType":"automated","remediationSummary":"Add a skip-link.","compliantCodeExample":"<a href=\"#content\">Skip</a>"},"skip-link":{"wcagId":"2.4.1","wcagLevel":"A","category":"Navigation","title":"Skip Link","plainDescription":"Missing skip-link navigation.","severity":"moderate","processType":"automated","remediationSummary":"Add a skip-link.","compliantCodeExample":"<a href=\"#main\">Skip to content</a>"},"document-title":{"wcagId":"2.4.2","wcagLevel":"A","category":"Navigation","title":"Page Titled","plainDescription":"Every page must have a unique title.","severity":"moderate","processType":"automated","remediationSummary":"Add a title tag.","compliantCodeExample":"<title>Page Title</title>"},"html-has-lang":{"wcagId":"3.1.1","wcagLevel":"A","category":"Language","title":"Language of Page","plainDescription":"The html element must have a lang attribute.","severity":"moderate","processType":"automated","remediationSummary":"Add lang attribute to html tag.","compliantCodeExample":"<html lang=\"en\">"},"html-lang-valid":{"wcagId":"3.1.1","wcagLevel":"A","category":"Language","title":"Valid Language","plainDescription":"Language code must be valid.","severity":"moderate","processType":"automated","remediationSummary":"Use a valid ISO language code.","compliantCodeExample":"<html lang=\"en-US\">"},"valid-lang":{"wcagId":"3.1.2","wcagLevel":"AA","category":"Language","title":"Language of Parts","plainDescription":"Language codes for parts must be valid.","severity":"moderate","processType":"automated","remediationSummary":"Use valid language code on element.","compliantCodeExample":"<span lang=\"fr\">Bonjour</span>"},"duplicate-id":{"wcagId":"4.1.1","wcagLevel":"A","category":"Structure","title":"Duplicate IDs","plainDescription":"IDs must be unique within the document.","severity":"critical","processType":"automated","remediationSummary":"Ensure each ID is unique.","compliantCodeExample":"<div id=\"unique-1\"></div>"},"color-contrast":{"wcagId":"1.4.3","wcagLevel":"AA","category":"Visual","title":"Contrast Minimum","plainDescription":"Text must maintain a minimum 4.5:1 contrast ratio between foreground and background.","severity":"serious","processType":"automated","remediationSummary":"Adjust text or background color.","compliantCodeExample":"<p style=\"color:#1f2937;\">Text</p>"},"meta-viewport":{"wcagId":"1.4.4","wcagLevel":"AA","category":"Visual","title":"Resize Text","plainDescription":"Viewport must allow pinch-to-zoom and scaling without disabling user magnification.","severity":"serious","processType":"automated","remediationSummary":"Do not disable user scaling.","compliantCodeExample":"<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">"},"heading-order":{"wcagId":"1.3.1","wcagLevel":"A","category":"Structure","title":"Heading Order","plainDescription":"Headings must follow a logical nesting order.","severity":"moderate","processType":"automated","remediationSummary":"Use hierarchical heading tags.","compliantCodeExample":"<h1>Title</h1><h2>Subtitle</h2>"},"empty-heading":{"wcagId":"2.4.6","wcagLevel":"AA","category":"Structure","title":"Empty Headings","plainDescription":"Headings must contain text.","severity":"moderate","processType":"automated","remediationSummary":"Add text to heading.","compliantCodeExample":"<h2>Section Title</h2>"},"focus-visible":{"wcagId":"2.4.7","wcagLevel":"AA","category":"Navigation","title":"Focus Visible","plainDescription":"Elements must show visible focus.","severity":"moderate","processType":"automated","remediationSummary":"Add focus styles.","compliantCodeExample":".item:focus { outline: 2px solid blue; }"},"image-alt":{"wcagId":"1.1.1","wcagLevel":"A","category":"Media & Objects","title":"Non-text Content","plainDescription":"Informative images require alt text.","severity":"critical","processType":"automated","remediationSummary":"Add descriptive alt text.","compliantCodeExample":"<img src=\"...\" alt=\"Description\">"},"area-alt":{"wcagId":"1.1.1","wcagLevel":"A","category":"Media & Objects","title":"Area Alt","plainDescription":"Image map areas must have alt text.","severity":"critical","processType":"automated","remediationSummary":"Add alt to area.","compliantCodeExample":"<area alt=\"Link\" />"},"object-alt":{"wcagId":"1.1.1","wcagLevel":"A","category":"Media & Objects","title":"Object Alt","plainDescription":"Objects must have alternative text.","severity":"moderate","processType":"automated","remediationSummary":"Add alt for objects.","compliantCodeExample":"<object><p>Description</p></object>"},"video-caption":{"wcagId":"1.2.2","wcagLevel":"A","category":"Media & Objects","title":"Video Captions","plainDescription":"Video must have captions.","severity":"critical","processType":"automated","remediationSummary":"Add track tag for captions.","compliantCodeExample":"<video><track kind=\"captions\" src=\"...\" /></video>"},"audio-caption":{"wcagId":"1.4.2","wcagLevel":"A","category":"Media & Objects","title":"Audio Captions","plainDescription":"Audio must have transcript or controls.","severity":"critical","processType":"automated","remediationSummary":"Provide transcript.","compliantCodeExample":"<audio controls><track kind=\"captions\" src=\"...\" /></audio>"},"blink":{"wcagId":"2.2.2","wcagLevel":"A","category":"Visual","title":"Blink","plainDescription":"Content must not blink.","severity":"moderate","processType":"automated","remediationSummary":"Remove blinking animation.","compliantCodeExample":"style=\"text-decoration:none;\""},"link-name":{"wcagId":"2.4.4","wcagLevel":"A","category":"Navigation","title":"Link Purpose","plainDescription":"Links must have accessible names.","severity":"moderate","processType":"automated","remediationSummary":"Provide text for links.","compliantCodeExample":"<a href=\"...\">Link Name</a>"},"label-title-only":{"wcagId":"2.5.3","wcagLevel":"A","category":"Forms","title":"Label in Name","plainDescription":"Visible label must match programmatic label for speech recognition users and ARIA naming.","severity":"moderate","processType":"automated","remediationSummary":"Sync labels.","compliantCodeExample":"<button aria-label=\"Submit\">Submit</button>"},"label":{"wcagId":"3.3.2","wcagLevel":"A","category":"Forms","title":"Labels or Instructions","plainDescription":"Inputs must have native <label> elements or explicit descriptions.","severity":"critical","processType":"automated","remediationSummary":"Use native label elements.","compliantCodeExample":"<label for=\"in\">Name</label><input id=\"in\" />"},"aria-allowed-attr":{"wcagId":"4.1.2","wcagLevel":"A","category":"ARIA","title":"ARIA Allowed Attribute","plainDescription":"Use only valid ARIA attributes.","severity":"moderate","processType":"automated","remediationSummary":"Check ARIA spec.","compliantCodeExample":"<div role=\"button\" aria-pressed=\"false\">"},"aria-required-attr":{"wcagId":"4.1.2","wcagLevel":"A","category":"ARIA","title":"ARIA Required Attribute","plainDescription":"Widgets must have required ARIA attributes.","severity":"moderate","processType":"automated","remediationSummary":"Add missing aria attributes.","compliantCodeExample":"<div role=\"tab\" aria-selected=\"true\">"},"button-name":{"wcagId":"4.1.2","wcagLevel":"A","category":"ARIA","title":"Button Name","plainDescription":"Buttons must have accessible names.","severity":"moderate","processType":"automated","remediationSummary":"Add accessible name.","compliantCodeExample":"<button aria-label=\"Action\">Action</button>"}}